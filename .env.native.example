# Use only with the local synthetic provider emulator by default.
SEARCH_BIND_ADDRESS=127.0.0.1
SEARCH_PORT=8080
SEARCH_DB_URL=jdbc:h2:mem:search-local;DB_CLOSE_DELAY=-1
SEARCH_DB_USER=sa
SEARCH_DB_PASSWORD=
SEARCH_DDL_MODE=create-drop
SEARCH_PROVIDER_TIMEOUT_MS=3000
KAKAO_BASE_URL=http://127.0.0.1:9091
KAKAO_API_KEY=local-synthetic
NAVER_BASE_URL=http://127.0.0.1:9091
NAVER_CLIENT_ID=local-synthetic
NAVER_CLIENT_SECRET=local-synthetic
SEARCH_STUB_PORT=9091
SEARCH_STUB_SCENARIO=normal
